{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./secrets/**)",
      "Bash(cat .env*:*)",
      "Bash(cat ./.env*:*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git filter-branch:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker system prune:*)",
      "Bash(kubectl:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(flyctl:*)",
      "Bash(vercel:*)",
      "Bash(heroku:*)",
      "Bash(prisma migrate deploy:*)",
      "Bash(npx prisma migrate deploy:*)",
      "Bash(pnpm prisma migrate deploy:*)",
      "Bash(prisma migrate reset:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(prisma db push:*)",
      "Bash(npx prisma db push:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout main:*)",
      "Bash(git checkout master:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(yarn add:*)",
      "Bash(npx:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(redis-cli:*)",
      "Bash(prisma migrate dev:*)",
      "Bash(npx prisma migrate dev:*)",
      "Bash(pnpm db:migrate:*)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./package.json)",
      "Edit(./**/package.json)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./package-lock.json)",
      "Edit(./yarn.lock)",
      "Edit(./Dockerfile)",
      "Edit(./docker-compose*.yml)",
      "Edit(./**/migrations/**)",
      "Edit(./prisma/schema.prisma)"
    ],
    "allow": [
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(tree:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm exec eslint --fix --no-error-on-unmatched-pattern $(jq -r '.tool_input.file_path // empty') 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}